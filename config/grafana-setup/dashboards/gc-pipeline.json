  "description": "Ingestion, rejets, file d'envoi et santé de Loki, Tempo et Prometheus.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "gc-prometheus"
      },
