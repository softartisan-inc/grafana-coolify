        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
