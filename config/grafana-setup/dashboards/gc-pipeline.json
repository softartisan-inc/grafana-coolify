        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
          "expr": "sum by (reason) (increase(loki_process_dropped_lines_total[$__rate_interval]))",
          "legendFormat": "Faro {{reason}}",
          "range": true,
          "refId": "D"
        }
      ],
