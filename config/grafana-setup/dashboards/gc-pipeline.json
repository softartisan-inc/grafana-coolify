          "legendFormat": "logs",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "points de métriques",
          "range": true,
          "refId": "C"
