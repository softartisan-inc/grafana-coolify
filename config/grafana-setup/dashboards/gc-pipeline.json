          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
          "expr": "sum(rate(faro_receiver_exceptions_total[$__rate_interval]))",
          "legendFormat": "exceptions",
          "range": true,
