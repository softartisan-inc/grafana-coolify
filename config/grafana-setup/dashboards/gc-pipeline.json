        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
          "expr": "sum (increase(otelcol_processor_filter_spans_filtered_total[$__rate_interval]))",
          "legendFormat": "OTLP traces",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gc-prometheus"
          },
          "expr": "sum (increase(otelcol_processor_filter_logs_filtered_total[$__rate_interval]))",
